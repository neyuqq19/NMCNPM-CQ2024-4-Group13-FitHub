# Option A — Supabase PostgreSQL (nhận mật khẩu thật từ PM, không commit mật khẩu thật):
# DATABASE_URL="postgresql://postgres.nejatinhcuaancvxktkm:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.nejatinhcuaancvxktkm:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Option B — Local PostgreSQL (See ../../docs/DATABASE.md):
DATABASE_URL="postgresql://fithub:fithub_local_only@localhost:55432/fithub?schema=public"
DIRECT_URL="postgresql://fithub:fithub_local_only@localhost:55432/fithub?schema=public"
PORT=3000
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a random value of at least 32 characters. Do not commit .env.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
# Required only when explicitly running seed; demo passwords are not production credentials.
SEED_PASSWORD=FitHubDemo!2026

# Email OTP (backend only; never put API keys in EXPO_PUBLIC_* or VITE_*).
RESEND_API_KEY=
# With no domain, only your Resend account email can receive test emails.
RESEND_FROM="FitHub <onboarding@resend.dev>"
# Optional: dedicated random secret (32+ characters); otherwise uses SESSION_SECRET.
OTP_HASH_SECRET=

# Generate a separate random secret of at least 32 characters. Required in production.
CHECKIN_SIGNING_SECRET=
