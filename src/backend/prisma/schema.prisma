generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TRAINER
  MEMBER
}

enum AccountStatus {
  PENDING_VERIFY
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum Platform {
  WEB
  MOBILE
}

enum MembershipStatus {
  PENDING_PAYMENT
  SCHEDULED
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  VNPAY
}

enum AccessWindow {
  REGULAR
  OFF_PEAK
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String?             @unique
  phone               String?             @unique
  displayName         String
  // Counter-created, unverified accounts have not set a password yet.
  passwordHash        String?
  role                Role                @default(MEMBER)
  status              AccountStatus       @default(PENDING_VERIFY)
  verifiedAt          DateTime?           @db.Timestamptz(3)
  failedLoginAttempts Int                 @default(0)
  loginLockedUntil    DateTime?           @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  authEvents          AuthEvent[]
  emailVerification   EmailVerification?
  trainerProfile      TrainerProfile?
  memberProfile       MemberProfile?
  confirmedPayments   Payment[]           @relation("PaymentConfirmer")
  auditLogs           AuditLog[]
  scanners            CheckInScanner[]
  createdFreezes      FreezePeriod[]      @relation("FreezeCreator")
  reportedIncidents   EquipmentIncident[] @relation("IncidentReporter")
  resolvedIncidents   EquipmentIncident[] @relation("IncidentResolver")
  equipmentHistory    EquipmentHistory[]  @relation("EquipmentActor")
  reminders           Reminder[]
  notifications       Notification[]
  pushDevices         PushDevice[]
}

model Session {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String           @unique
  requestId  String           @unique @db.Uuid
  platform   Platform
  deviceId   String           @db.Uuid
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime         @db.Timestamptz(3)
  revokedAt  DateTime?        @db.Timestamptz(3)
  checkInQrs CheckInQr[]
  scanners   CheckInScanner[]

  @@index([userId, revokedAt])
}

model AuthEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform  Platform
  deviceId  String   @db.Uuid
  result    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model MemberProfile {
  bookedTrainerSlots WorkingSlot[]
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @unique @db.Uuid
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  memberCode         String           @unique
  dateOfBirth        DateTime?        @db.Date
  address            String?
  gender             Gender?
  heightCm           Decimal?         @db.Decimal(5, 2)
  weightKg           Decimal?         @db.Decimal(5, 2)
  injuryHistory      String?
  // API updates must match and increment this version to prevent lost updates.
  version            Int              @default(0)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  memberships        Membership[]
  checkInQrs         CheckInQr[]
  checkIns           CheckInRecord[]
  workoutSessions    WorkoutSession[]
  personalRecords    PersonalRecord[]
}

model Package {
  id                 String       @id @default(uuid()) @db.Uuid
  code               String       @unique
  name               String
  durationMonths     Int
  price              Decimal      @db.Decimal(12, 0)
  grantsGymAccess    Boolean      @default(true)
  ptSessionsIncluded Int          @default(0)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  accessWindow       AccessWindow @default(REGULAR)
  memberships        Membership[]
}

model Membership {
  id                      String           @id @default(uuid()) @db.Uuid
  code                    String           @unique
  // One registration request creates at most one membership.
  requestId               String           @unique @db.Uuid
  memberId                String           @db.Uuid
  member                  MemberProfile    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  packageId               String           @db.Uuid
  package                 Package          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageNameSnapshot     String
  durationMonthsSnapshot  Int
  priceSnapshot           Decimal          @db.Decimal(12, 0)
  accessWindowSnapshot    AccessWindow     @default(REGULAR)
  grantsGymAccessSnapshot Boolean
  ptSessionsSnapshot      Int              @default(0)
  ptSessionsRemaining     Int              @default(0)
  status                  MembershipStatus @default(PENDING_PAYMENT)
  // Local gym calendar dates; startsOn inclusive, endsBefore exclusive.
  startsOn                DateTime         @db.Date
  endsBefore              DateTime         @db.Date
  version                 Int              @default(0)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)
  payment                 Payment?
  checkIns                CheckInRecord[]
  freezePeriods           FreezePeriod[]

  @@index([memberId, status])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  membershipId   String        @unique @db.Uuid
  membership     Membership    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(12, 0)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique @db.Uuid

  // confirmedById đã để String? (Optional) - Giải quyết đúng vấn đề VNPay không có Admin thu tiền
  confirmedById String?   @db.Uuid
  confirmedBy   User?     @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  // SỬA ĐỔI: Dùng Enum thay vì String
  benefitStatus        BenefitStatus        @default(GRANTED)
  reconciliationStatus ReconciliationStatus @default(NONE)

  // SỬA ĐỔI: Thêm @unique để backend bắt Webhook VNPay nhanh và chuẩn xác
  vnpTxnRef        String?  @unique
  vnpTransactionNo String?
  invoice          Invoice?

  @@index([status, confirmedAt])
  @@index([createdAt, id])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String   @db.Uuid
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action        String
  entityType    String
  entityId      String   @db.Uuid
  // Field names only. Do not copy passwords, tokens or medical information.
  changedFields String[]
  reason        String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
}

model EmailVerification {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  codeHash       String
  generation     Int       @default(1)
  expiresAt      DateTime  @db.Timestamptz(3)
  lastSentAt     DateTime  @db.Timestamptz(3)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)
  consumedAt     DateTime? @db.Timestamptz(3)
  deliveryStatus String    @default("SENDING")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

model CheckInScanner {
  id           String               @id @default(uuid()) @db.Uuid
  sessionId    String               @db.Uuid
  session      Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  adminId      String               @db.Uuid
  admin        User                 @relation(fields: [adminId], references: [id], onDelete: Restrict)
  deviceId     String               @db.Uuid
  label        String
  enabled      Boolean              @default(true)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  transactions CheckInTransaction[]

  @@unique([sessionId, deviceId])
}

model CheckInQr {
  id           String               @id @default(uuid()) @db.Uuid
  memberId     String               @db.Uuid
  member       MemberProfile        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sessionId    String               @db.Uuid
  session      Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  step         Int
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime             @db.Timestamptz(3)
  transactions CheckInTransaction[]

  @@unique([sessionId, step])
  @@index([memberId, createdAt])
}

model CheckInTransaction {
  id          String         @id @db.Uuid
  scannerId   String         @db.Uuid
  scanner     CheckInScanner @relation(fields: [scannerId], references: [id], onDelete: Restrict)
  qrId        String?        @db.Uuid
  qr          CheckInQr?     @relation(fields: [qrId], references: [id], onDelete: Restrict)
  // SHA-256 only; never persist the scannable QR.
  payloadHash String
  result      Json
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  record      CheckInRecord?
}

model CheckInRecord {
  id            String             @id @default(uuid()) @db.Uuid
  transactionId String             @unique @db.Uuid
  transaction   CheckInTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  memberId      String             @db.Uuid
  member        MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membershipId  String             @db.Uuid
  membership    Membership         @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  checkedInAt   DateTime           @db.Timestamptz(3)

  @@index([memberId, checkedInAt])
}

// ===== UC13 — Nhật ký tập luyện (SAD 4.9, UCSpec 3.4.4) =====

// W = khởi động, R = hiệp chính, D = drop set, F = tới ngưỡng thất bại.
enum WorkoutSetType {
  W
  R
  D
  F
}

model WorkoutSession {
  id              String            @id @default(uuid()) @db.Uuid
  memberId        String            @db.Uuid
  member          MemberProfile     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  title           String
  // Local gym calendar date (Asia/Ho_Chi_Minh).
  performedOn     DateTime          @db.Date
  durationMinutes Int?
  notes           String?
  // BR01: sum of reps * weightKg over every set in the session.
  totalVolume     Decimal           @default(0) @db.Decimal(12, 2)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  exercises       WorkoutExercise[]

  @@index([memberId, performedOn])
}

model WorkoutExercise {
  id           String         @id @default(uuid()) @db.Uuid
  sessionId    String         @db.Uuid
  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseName String
  // Lower-cased, whitespace-collapsed name; records are matched on this key.
  exerciseKey  String
  orderIndex   Int
  sets         WorkoutSet[]

  @@unique([sessionId, exerciseKey])
  @@index([exerciseKey])
}

model WorkoutSet {
  id           String          @id @default(uuid()) @db.Uuid
  exerciseId   String          @db.Uuid
  exercise     WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber    Int
  setType      WorkoutSetType
  reps         Int
  weightKg     Decimal         @db.Decimal(6, 2)
  // BR02/BR03: only R sets with external load get an Epley estimate.
  estimated1RM Decimal?        @db.Decimal(8, 2)
  isPR         Boolean         @default(false)

  @@unique([exerciseId, setNumber])
}

model PersonalRecord {
  id           String        @id @default(uuid()) @db.Uuid
  memberId     String        @db.Uuid
  member       MemberProfile @relation(fields: [memberId], references: [id], onDelete: Restrict)
  exerciseName String
  exerciseKey  String
  oneRepMax    Decimal       @db.Decimal(8, 2)
  weightKg     Decimal       @db.Decimal(6, 2)
  reps         Int
  achievedOn   DateTime      @db.Date
  // Set that holds the record. Rebuilt whenever sessions change, so no FK.
  setId        String        @db.Uuid
  // BR04: true while the first session's best has never been beaten.
  isBaseline   Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([memberId, exerciseKey])
}

enum FreezeStatus {
  ACTIVE
  ENDED
}

model FreezePeriod {
  id           String       @id @default(uuid()) @db.Uuid
  membershipId String       @db.Uuid
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  startsOn     DateTime     @db.Date
  endsBefore   DateTime     @db.Date
  days         Int
  reason       String
  status       FreezeStatus @default(ACTIVE)
  createdById  String       @db.Uuid
  createdBy    User         @relation("FreezeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  endedAt      DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  @@index([membershipId, status])
}

enum TrainerWorkStatus {
  ACTIVE
  ON_LEAVE
}

model TrainerProfile {
  workStatus      TrainerWorkStatus      @default(ACTIVE)
  workingSlots    WorkingSlot[]
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @unique @db.Uuid
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainerCode     String                 @unique
  bio             String                 @default("")
  specialties     String[]               @default([])
  experienceYears Int                    @default(0)
  avatarUrl       String?
  version         Int                    @default(0)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  certifications  TrainerCertification[]
}

model TrainerCertification {
  id            String         @id @default(uuid()) @db.Uuid
  trainerId     String         @db.Uuid
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name          String
  issuer        String
  issuedAt      DateTime       @db.Date
  credentialUrl String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([trainerId])
}

enum WorkingSlotStatus {
  OPEN
  BOOKED
  UNAVAILABLE
}

model WorkingSlot {
  id                String            @id @default(uuid()) @db.Uuid
  trainerId         String            @db.Uuid
  trainer           TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  workDate          DateTime          @db.Date
  startTime         DateTime          @db.Timestamptz(3)
  endTime           DateTime          @db.Timestamptz(3)
  status            WorkingSlotStatus @default(OPEN)
  unavailableReason String?
  memberId          String?           @db.Uuid
  member            MemberProfile?    @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([trainerId, workDate, startTime])
  @@unique([trainerId, startTime])
}

enum EquipmentCategory {
  CARDIO
  STRENGTH
  FREE_WEIGHT
  FUNCTIONAL
}

enum EquipmentStatus {
  OPERATIONAL
  OUT_OF_ORDER
  RETIRED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  RESOLVED
  REJECTED
}

model Equipment {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @unique
  name          String
  category      EquipmentCategory
  zone          String
  status        EquipmentStatus     @default(OPERATIONAL)
  qrCodePayload String              @unique
  purchasedAt   DateTime?           @db.Date
  warrantyUntil DateTime?           @db.Date
  notes         String?
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  incidents     EquipmentIncident[]
  history       EquipmentHistory[]

  @@index([category, status])
  @@index([status])
}

model EquipmentIncident {
  id             String           @id @default(uuid()) @db.Uuid
  equipmentId    String           @db.Uuid
  equipment      Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  reportedById   String?          @db.Uuid
  reportedBy     User?            @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedById   String?          @db.Uuid
  resolvedBy     User?            @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  description    String
  severity       IncidentSeverity @default(MEDIUM)
  status         IncidentStatus   @default(OPEN)
  resolutionNote String?
  reportedAt     DateTime         @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@index([equipmentId, status])
}

model EquipmentHistory {
  id          String           @id @default(uuid()) @db.Uuid
  equipmentId String           @db.Uuid
  equipment   Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  actorId     String?          @db.Uuid
  actor       User?            @relation("EquipmentActor", fields: [actorId], references: [id], onDelete: Restrict)
  action      String
  fromStatus  EquipmentStatus?
  toStatus    EquipmentStatus
  note        String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([equipmentId, createdAt])
}

// ===== UC16 - Nhac lich / nhac han goi tap (SAD 4.11) =====
enum ReminderSource {
  APPOINTMENT
  MEMBERSHIP
}

enum ReminderType {
  PT_REMINDER_24H
  PT_REMINDER_2H
  PACKAGE_EXPIRY_7D
  PACKAGE_EXPIRY_3D
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  SKIPPED
}

enum NotificationType {
  PT_REMINDER
  PACKAGE_EXPIRY
}

enum DeliveryStatus {
  SENT
  FAILED
}

// A scheduled reminder. The unique key stops the same reminder being created or sent twice.
model Reminder {
  id           String         @id @default(uuid()) @db.Uuid
  recipientId  String         @db.Uuid
  recipient    User           @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  sourceType   ReminderSource
  // Appointment id or membership id, depending on sourceType.
  sourceId     String         @db.Uuid
  reminderType ReminderType
  scheduledAt  DateTime       @db.Timestamptz(3)
  status       ReminderStatus @default(PENDING)
  sentAt       DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  notification Notification?

  @@unique([sourceType, sourceId, reminderType, recipientId])
  @@index([status, scheduledAt])
  @@index([sourceType, sourceId])
}

// In-app inbox row. Stored independently of whether the push was delivered (BR04).
model Notification {
  id               String            @id @default(uuid()) @db.Uuid
  recipientId      String            @db.Uuid
  recipient        User              @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  reminderId       String?           @unique @db.Uuid
  reminder         Reminder?         @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  type             NotificationType
  title            String
  body             String
  targetScreen     String
  sourceId         String?           @db.Uuid
  isRead           Boolean           @default(false)
  readAt           DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  deliveryAttempts DeliveryAttempt[]

  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
}

model DeliveryAttempt {
  id             String         @id @default(uuid()) @db.Uuid
  notificationId String         @db.Uuid
  notification   Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  status         DeliveryStatus
  errorMessage   String?
  attemptedAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([notificationId])
}

model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  platform  Platform
  pushToken String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, deviceId])
}

enum InvoiceStatus {
  ISSUED
  FAILED
}

enum BenefitStatus {
  GRANTED
  NEEDS_REVIEW
  NONE
}

enum ReconciliationStatus {
  RECONCILED
  MISMATCHED
  NONE
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  paymentId    String        @unique @db.Uuid
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status       InvoiceStatus @default(ISSUED)
  issuedAt     DateTime      @default(now()) @db.Timestamptz(3)
  pdfUrl       String?
  errorMessage String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
}
