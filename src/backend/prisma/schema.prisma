generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TRAINER
  MEMBER
}

enum AccountStatus {
  PENDING_VERIFY
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum Platform {
  WEB
  MOBILE
}

enum MembershipStatus {
  PENDING_PAYMENT
  SCHEDULED
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
}

enum AccessWindow {
  REGULAR
  OFF_PEAK
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  email               String?            @unique
  phone               String?            @unique
  displayName         String
  // Counter-created, unverified accounts have not set a password yet.
  passwordHash        String?
  role                Role               @default(MEMBER)
  status              AccountStatus      @default(PENDING_VERIFY)
  verifiedAt          DateTime?          @db.Timestamptz(3)
  failedLoginAttempts Int                @default(0)
  loginLockedUntil    DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  authEvents          AuthEvent[]
  emailVerification   EmailVerification?
  trainerProfile      TrainerProfile?
  memberProfile       MemberProfile?
  confirmedPayments   Payment[]          @relation("PaymentConfirmer")
  auditLogs           AuditLog[]
  scanners            CheckInScanner[]
}

model Session {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String           @unique
  requestId  String           @unique @db.Uuid
  platform   Platform
  deviceId   String           @db.Uuid
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime         @db.Timestamptz(3)
  revokedAt  DateTime?        @db.Timestamptz(3)
  checkInQrs CheckInQr[]
  scanners   CheckInScanner[]

  @@index([userId, revokedAt])
}

model AuthEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform  Platform
  deviceId  String   @db.Uuid
  result    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model MemberProfile {
  bookedTrainerSlots WorkingSlot[]
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @unique @db.Uuid
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  memberCode    String          @unique
  dateOfBirth   DateTime?       @db.Date
  address       String?
  gender        Gender?
  heightCm      Decimal?        @db.Decimal(5, 2)
  weightKg      Decimal?        @db.Decimal(5, 2)
  injuryHistory String?
  // API updates must match and increment this version to prevent lost updates.
  version       Int             @default(0)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  memberships   Membership[]
  checkInQrs    CheckInQr[]
  checkIns      CheckInRecord[]
}

model Package {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique
  name            String
  durationMonths  Int
  price           Decimal      @db.Decimal(12, 0)
  grantsGymAccess Boolean      @default(true)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  accessWindow    AccessWindow @default(REGULAR)
  memberships     Membership[]
}

model Membership {
  id                      String           @id @default(uuid()) @db.Uuid
  code                    String           @unique
  // One registration request creates at most one membership.
  requestId               String           @unique @db.Uuid
  memberId                String           @db.Uuid
  member                  MemberProfile    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  packageId               String           @db.Uuid
  package                 Package          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageNameSnapshot     String
  durationMonthsSnapshot  Int
  priceSnapshot           Decimal          @db.Decimal(12, 0)
  accessWindowSnapshot    AccessWindow     @default(REGULAR)
  grantsGymAccessSnapshot Boolean
  status                  MembershipStatus @default(PENDING_PAYMENT)
  // Local gym calendar dates; startsOn inclusive, endsBefore exclusive.
  startsOn                DateTime         @db.Date
  endsBefore              DateTime         @db.Date
  version                 Int              @default(0)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)
  payment                 Payment?
  checkIns                CheckInRecord[]

  @@index([memberId, status])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  membershipId   String        @unique @db.Uuid
  membership     Membership    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(12, 0)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique @db.Uuid
  confirmedById  String?       @db.Uuid
  confirmedBy    User?         @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, confirmedAt])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String   @db.Uuid
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action        String
  entityType    String
  entityId      String   @db.Uuid
  // Field names only. Do not copy passwords, tokens or medical information.
  changedFields String[]
  reason        String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
}

model EmailVerification {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  codeHash       String
  generation     Int       @default(1)
  expiresAt      DateTime  @db.Timestamptz(3)
  lastSentAt     DateTime  @db.Timestamptz(3)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)
  consumedAt     DateTime? @db.Timestamptz(3)
  deliveryStatus String    @default("SENDING")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

model CheckInScanner {
  id           String               @id @default(uuid()) @db.Uuid
  sessionId    String               @db.Uuid
  session      Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  adminId      String               @db.Uuid
  admin        User                 @relation(fields: [adminId], references: [id], onDelete: Restrict)
  deviceId     String               @db.Uuid
  label        String
  enabled      Boolean              @default(true)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  transactions CheckInTransaction[]

  @@unique([sessionId, deviceId])
}

model CheckInQr {
  id           String               @id @default(uuid()) @db.Uuid
  memberId     String               @db.Uuid
  member       MemberProfile        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sessionId    String               @db.Uuid
  session      Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  step         Int
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime             @db.Timestamptz(3)
  transactions CheckInTransaction[]

  @@unique([sessionId, step])
  @@index([memberId, createdAt])
}

model CheckInTransaction {
  id          String         @id @db.Uuid
  scannerId   String         @db.Uuid
  scanner     CheckInScanner @relation(fields: [scannerId], references: [id], onDelete: Restrict)
  qrId        String?        @db.Uuid
  qr          CheckInQr?     @relation(fields: [qrId], references: [id], onDelete: Restrict)
  // SHA-256 only; never persist the scannable QR.
  payloadHash String
  result      Json
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  record      CheckInRecord?
}

model CheckInRecord {
  id            String             @id @default(uuid()) @db.Uuid
  transactionId String             @unique @db.Uuid
  transaction   CheckInTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  memberId      String             @db.Uuid
  member        MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membershipId  String             @db.Uuid
  membership    Membership         @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  checkedInAt   DateTime           @db.Timestamptz(3)

  @@index([memberId, checkedInAt])
}

model TrainerProfile {
  workingSlots    WorkingSlot[]
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @unique @db.Uuid
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainerCode     String                 @unique
  bio             String                 @default("")
  specialties     String[]               @default([])
  experienceYears Int                    @default(0)
  avatarUrl       String?
  version         Int                    @default(0)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  certifications  TrainerCertification[]
}

model TrainerCertification {
  id            String         @id @default(uuid()) @db.Uuid
  trainerId     String         @db.Uuid
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name          String
  issuer        String
  issuedAt      DateTime       @db.Date
  credentialUrl String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([trainerId])
}

enum WorkingSlotStatus {
  OPEN
  BOOKED
  UNAVAILABLE
}

model WorkingSlot {
  id                String            @id @default(uuid()) @db.Uuid
  trainerId         String            @db.Uuid
  trainer           TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  workDate          DateTime          @db.Date
  startTime         DateTime          @db.Timestamptz(3)
  endTime           DateTime          @db.Timestamptz(3)
  status            WorkingSlotStatus @default(OPEN)
  unavailableReason String?
  memberId          String?           @db.Uuid
  member            MemberProfile?    @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([trainerId, workDate, startTime])
  @@unique([trainerId, startTime])
}
