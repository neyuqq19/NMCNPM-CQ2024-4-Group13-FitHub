    "expo-crypto": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  }
