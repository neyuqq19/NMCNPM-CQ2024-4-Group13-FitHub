{
  "name": "fithub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "web-client",
    "mobile-client",
    "shared"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:api": "npm run dev -w @fithub/api",
    "dev:web": "npm run dev -w @fithub/web",
    "dev:mobile": "npm run start -w @fithub/mobile",
    "build": "npm run build -w @fithub/contracts && npm run build -w @fithub/api && npm run build -w @fithub/web",
    "typecheck": "npm run build -w @fithub/contracts && npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @fithub/api",
    "db:migrate": "npm run db:migrate -w @fithub/api",
    "db:seed": "npm run db:seed -w @fithub/api",
    "db:prepare": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:status": "npm run db:status -w @fithub/api",
    "db:studio": "npm run db:studio -w @fithub/api",
    "db:test": "node scripts/test-database.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "test": "npm run build -w @fithub/contracts && npm run test -w @fithub/api",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:mobile": "node scripts/test-mobile.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "~5.9.3"
  }
}
